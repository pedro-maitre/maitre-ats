generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  logoUrl           String?
  primaryColor      String?  @default("#D4AF37")
  bannerHeadline    String?
  bannerSubheadline String?
  aboutUs           String?
  websiteUrl        String?
  isMaster          Boolean  @default(false) // Define se é a Empresa Master/Mantenedora (Maître)
  
  // Dados Jurídicos & Institucionais
  legalName         String?  // Razão Social
  cnpj              String?  // CNPJ da empresa
  industry          String?  // Ramo / Setor de atuação
  companySize       String?  // Porte da empresa (ex: "1-10", "11-50", "51-200")
  foundedYear       Int?     // Ano de fundação

  // Comunicação & Redes
  email             String?  // E-mail institucional de contato
  phone             String?  // Telefone / WhatsApp comercial
  linkedinUrl       String?  // LinkedIn institucional
  instagramUrl      String?  // Instagram da empresa

  // Endereço Corporativo
  addressZipCode    String?  // CEP
  addressStreet     String?  // Logradouro / Rua
  addressNumber     String?  // Número
  addressComplement String?  // Complemento
  addressNeighborhood String? // Bairro
  addressCity       String?  // Cidade
  addressState      String?  // Estado (UF)

  // Cultura & Propósito
  cultureValues     String?  // Missão, Visão e Valores institucionais

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users       User[]
  memberships OrganizationMembership[]
  jobs        Job[]
  stages      Stage[]  // Global or org-level stages
  candidates  Candidate[]
  documents   Document[]
  outbox      IntegrationOutbox[]
  retentionPolicies RetentionPolicy[]
  performanceEvaluations PerformanceEvaluation[]
  developmentPlans       DevelopmentPlan[]
  surveys                ClimateSurvey[]
  surveyResponses        SurveyResponse[]
  recognitions           CultureRecognition[]
  courses                Course[]
  courseEnrollments      CourseEnrollment[]
  departments            Department[]
  positions              Position[]
  employees              Employee[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String?
  name           String?
  role           String       @default("CANDIDATE") // SUPER_ADMIN, ADMIN, RECRUITER, CANDIDATE
  
  // Perfil do Colaborador / Recrutador / Admin
  jobTitle       String?      // Cargo / Função na Maître (ex: "Recrutadora Sênior", "Head de R&S", "Admin")
  department     String?      // Departamento (ex: "Recursos Humanos", "Diretoria", "Tecnologia")
  phone          String?      // WhatsApp / Telefone profissional
  avatarUrl      String?      // Foto de perfil
  linkedinUrl    String?      // Perfil no LinkedIn
  bio            String?      // Resumo profissional / Minibio
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  joinedAt       DateTime?    // Data de admissão / início na equipe

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  memberships    OrganizationMembership[]
  
  // Relations
  jobsManaged    Job[]        @relation("HiringManager")
  jobsRecruited  Job[]        @relation("Recruiter")
  evaluations    Evaluation[]
  scorecards     Scorecard[]  @relation("ScorecardEvaluator")
  activities     Activity[]

  candidate      Candidate?   // Link user to candidate profile
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("RECRUITER") // ADMIN, RECRUITER, HIRING_MANAGER, INTERVIEWER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Job {
  id                      String       @id @default(cuid())
  title                   String
  description             String
  department              String?
  location                String?      // e.g., "Remote", "São Paulo, SP"
  employmentType          String?      // e.g., "CLT", "PJ", "ESTAGIO", "TEMPORARIO"
  seniority               String?      // e.g., "ESTAGIO", "JUNIOR", "PLENO", "SENIOR", "ESPECIALISTA", "LEAD", "DIRETORIA"
  requiredSkills          String?      // JSON string or comma separated tags
  salaryMin               Float?
  salaryMax               Float?
  salaryFitTolerancePercent Float?     @default(15.0) // Tolerância percentual de fit salarial configurável
  status                  String       @default("OPEN") // OPEN, PAUSED, CLOSED
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id])
  
  hiringManagerId         String?
  hiringManager           User?        @relation("HiringManager", fields: [hiringManagerId], references: [id])
  recruiterId             String?
  recruiter               User?        @relation("Recruiter", fields: [recruiterId], references: [id])

  applications            Application[]
  stages                  Stage[]      // Custom stages per job

  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([organizationId, status])
}

model Candidate {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  email            String       @unique
  phone            String?
  resumeUrl        String?      // Link do PDF
  documentId       String?      // Referência ao registro de Documento Privado
  linkedinUrl      String?
  source           String?
  profileSummary   String?
  tags             String?      // JSON string or comma separated
  
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])

  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id])

  applications     Application[]
  documents        Document[]
  consents         CandidateConsent[]
  performanceEvaluations PerformanceEvaluation[]
  developmentPlans       DevelopmentPlan[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, createdAt])
}

model Stage {
  id               String       @id @default(cuid())
  name             String       // e.g., "Triagem", "Entrevista RH"
  order            Int
  jobId            String?
  job              Job?         @relation(fields: [jobId], references: [id])
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])

  applications     Application[]
  fromTransitions  ApplicationStageTransition[] @relation("FromStageTransitions")
  toTransitions    ApplicationStageTransition[] @relation("ToStageTransitions")

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Application {
  id               String       @id @default(cuid())
  candidateId      String
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId          String
  stage            Stage        @relation(fields: [stageId], references: [id])
  
  matchScore       Float?       // Percentage 0-100
  priority         String       @default("NORMAL") // PRIORIZADO, NORMAL, DUVIDA
  fitCategory      String?      // ALTO_FIT, MEDIO_FIT, BAIXO_FIT
  salaryExpectation Float?
  enteredStageAt   DateTime     @default(now())
  
  // Governança de IA & Fit 3D
  algorithmVersion String?      @default("v3.0-fit3d")
  aiExplanation    String?
  aiSnapshot       String?      // JSON snapshot
  manualOverride   Boolean      @default(false)
  overrideReason   String?
  reviewedBy       String?
  reviewedAt       DateTime?

  evaluations      Evaluation[]
  activities       Activity[]
  transitions      ApplicationStageTransition[]
  interviews       Interview[]
  offers           Offer[]
  hireConversion   HireConversion?

  createdAt        DateTime     @default(now()) // apply date
  updatedAt        DateTime     @updatedAt

  @@index([jobId, stageId])
}

model ApplicationStageTransition {
  id            String       @id @default(cuid())
  applicationId String
  fromStageId   String?
  toStageId     String
  changedBy     String       // ID do usuário ou "SYSTEM"
  reason        String?
  changedAt     DateTime     @default(now())

  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     Stage?       @relation("FromStageTransitions", fields: [fromStageId], references: [id])
  toStage       Stage        @relation("ToStageTransitions", fields: [toStageId], references: [id])

  @@index([applicationId, changedAt])
}

model Document {
  id                 String       @id @default(cuid())
  organizationId     String
  candidateId        String?
  provider           String       @default("SUPABASE_PRIVATE")
  bucket             String       @default("resumes-private")
  storageKey         String
  originalName       String
  mimeType           String       @default("application/pdf")
  sizeBytes          Int          @default(0)
  checksum           String?
  classification     String       @default("CURRICULO") // CURRICULO, RG_CNH, CPF, CTPS, RESIDENCIA, DIPLOMA, TITULO_ELEITOR, ASO, DADOS_BANCARIOS, TERMO_LGPD
  status             String       @default("APPROVED") // PENDING, APPROVED, REJECTED
  rejectionReason    String?
  retentionUntil     DateTime?
  createdAt          DateTime     @default(now())

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate          Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([organizationId, candidateId])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String       // RESUME_DOWNLOAD, STAGE_CHANGE, CANDIDATE_DELETE, ROLE_CHANGE, OVERRIDE_FIT, HIRE_AUTHORIZED, EXPORT_DATA
  resourceType   String       // Application, Candidate, Job, Document, User
  resourceId     String
  beforeData     String?      // JSON snapshot
  afterData      String?      // JSON snapshot
  ipAddress      String?
  userAgent      String?
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
}

model Interview {
  id             String       @id @default(cuid())
  applicationId  String
  title          String
  scheduledAt    DateTime
  durationMin    Int          @default(45)
  format         String       @default("ONLINE") // ONLINE, IN_PERSON
  meetingUrl     String?
  status         String       @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecards     Scorecard[]

  @@index([applicationId, scheduledAt])
}

model Scorecard {
  id                 String       @id @default(cuid())
  interviewId        String
  evaluatorId        String
  technicalScore     Float        @default(0) // 1 to 5
  cultureScore       Float        @default(0) // 1 to 5
  communicationScore Float        @default(0) // 1 to 5
  overallRecommendation String   @default("HIRE") // STRONG_HIRE, HIRE, HOLD, NO_HIRE
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  interview          Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator          User         @relation("ScorecardEvaluator", fields: [evaluatorId], references: [id])

  @@index([interviewId, evaluatorId])
}

model Offer {
  id             String       @id @default(cuid())
  applicationId  String
  salaryOffered  Float
  employmentType String       @default("CLT") // CLT, PJ, ESTAGIO
  startDate      DateTime?
  benefits       String?      // JSON string or text
  status         String       @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, ACCEPTED, REJECTED
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model HireConversion {
  id               String       @id @default(cuid())
  applicationId    String       @unique
  convertedBy      String
  employeeCode     String?
  status           String       @default("CONVERTED") // CONVERTED, PENDING_ONBOARDING
  token            String?      @unique
  admissionStatus  String       @default("PENDING_DOCUMENTS") // PENDING_DOCUMENTS, UNDER_REVIEW, REQUIREMENT, APPROVED, MATRICULATED
  additionalData   String?      // JSON string with bank info, PIS, civil status, address, dependents
  targetStartDate  DateTime?
  notes            String?
  reviewedBy       String?
  reviewedAt       DateTime?
  convertedAt      DateTime     @default(now())

  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model IntegrationOutbox {
  id             String       @id @default(cuid())
  organizationId String
  eventType      String       // candidate.hire_authorized.v1, application.stage_changed.v1
  payload        String       // JSON estruturado
  status         String       @default("PENDING") // PENDING, PUBLISHED, FAILED
  attempts       Int          @default(0)
  occurredAt     DateTime     @default(now())
  publishedAt    DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, occurredAt])
}

model Evaluation {
  id               String       @id @default(cuid())
  applicationId    String
  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluatorId      String
  evaluator        User         @relation(fields: [evaluatorId], references: [id])
  
  rating           Int          // 1 to 5
  feedback         String
  structuredData   String?      // JSON string

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Activity {
  id               String       @id @default(cuid())
  applicationId    String
  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId          String?
  actor            User?        @relation(fields: [actorId], references: [id])
  
  type             String       // e.g., "STAGE_CHANGE", "NOTE_ADDED", "APPLICATION_SUBMITTED"
  description      String
  metadata         String?      // JSON string

  createdAt        DateTime     @default(now())
}

model CandidateConsent {
  id             String       @id @default(cuid())
  candidateId    String
  purpose        String       // R&S, BANCO_TALENTOS, CONTATO_FUTURO
  granted        Boolean      @default(true)
  grantedAt      DateTime     @default(now())
  revokedAt      DateTime?
  ipAddress      String?

  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, purpose])
}

model RetentionPolicy {
  id             String       @id @default(cuid())
  organizationId String
  dataType       String       // RESUME_PDF, INACTIVE_CANDIDATE, INTERVIEW_NOTES
  retentionDays  Int          @default(730) // 2 anos por padrão
  actionOnExpiry String       // ANONYMIZE, DELETE
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DataSubjectRequest {
  id             String       @id @default(cuid())
  email          String
  requestType    String       // ACCESS, CORRECTION, DELETION, REVOCATION
  status         String       @default("PENDING") // PENDING, COMPLETED, REJECTED
  justification  String?
  requestedAt    DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([email, requestType])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PerformanceEvaluation {
  id               String       @id @default(cuid())
  organizationId   String
  candidateId      String
  evaluatorId      String?
  cycleName        String       @default("Ciclo Anual 2026")
  performanceScore Float        @default(3.0) // 1.0 a 5.0
  potentialScore   Float        @default(3.0) // 1.0 a 5.0
  boxPosition      String       @default("KEY_PROFESSIONAL") // TOP_TALENT, FUTURE_LEADER, ENIGMA, HIGH_PERFORMER, KEY_PROFESSIONAL, DILEMMA, TECHNICAL_EXPERT, EFFECTIVE, RISK
  competencies     String?      // JSON string
  strengths        String?
  improvements     String?
  evaluatedAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, candidateId])
}

model DevelopmentPlan {
  id              String       @id @default(cuid())
  organizationId  String
  candidateId     String
  title           String
  description     String?
  status          String       @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DELAYED
  category        String       @default("TECH_SKILLS") // TECH_SKILLS, LEADERSHIP, SOFT_SKILLS, CERTIFICATION
  targetDate      DateTime?
  completedAt     DateTime?
  actionItems     String?      // JSON string of items
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate       Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, candidateId])
}

model ClimateSurvey {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         String           @default("ACTIVE") // ACTIVE, CLOSED
  startDate      DateTime         @default(now())
  endDate        DateTime?
  targetAudience String           @default("ALL") // ALL, LEADERSHIP, TECH, SALES
  questions      String?          // JSON array of questions
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses      SurveyResponse[]

  @@index([organizationId, status])
}

model SurveyResponse {
  id             String        @id @default(cuid())
  surveyId       String
  organizationId String
  department     String?
  npsScore       Int           // 0 a 10
  dimensionScores String?      // JSON string com notas Likert (ex: {"leadership": 4.5, "communication": 4.0})
  feedback       String?
  respondedAt    DateTime      @default(now())

  survey         ClimateSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, surveyId])
}

model CultureRecognition {
  id                 String       @id @default(cuid())
  organizationId     String
  senderId           String?
  senderName         String
  receiverName       String
  receiverDepartment String?
  valuePillar        String       // INOVACAO, EXCELENCIA, COLABORACAO, FOCO_NO_CLIENTE, RESPEITO
  message            String
  likesCount         Int          @default(0)
  createdAt          DateTime     @default(now())

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Course {
  id                  String             @id @default(cuid())
  organizationId      String
  title               String
  slug                String
  description         String
  category            String             // ONBOARDING, LIDERANCA, COMPLIANCE_LGPD, ATENDIMENTO, METODOLOGIA_MAITRE
  coverUrl            String?
  durationMinutes     Int                @default(60)
  status              String             @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  modules             String             // JSON string de módulos e aulas
  isOnboardingDefault Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments         CourseEnrollment[]

  @@index([organizationId, category])
}

model CourseEnrollment {
  id              String       @id @default(cuid())
  organizationId  String
  courseId        String
  userId          String?
  candidateId     String?
  employeeName    String
  employeeEmail   String
  progressPercent Int          @default(0) // 0 a 100
  status          String       @default("IN_PROGRESS") // ENROLLED, IN_PROGRESS, COMPLETED
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  certificateCode String?      @unique
  score           Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, courseId])
  @@index([employeeEmail])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  positions      Position[]
  employees      Employee[]

  @@index([organizationId, name])
}

model Position {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  title          String
  cboCode        String?
  level          String?      // JUNIOR, PLENO, SENIOR, ESPECIALISTA, LIDERANCA, DIRETORIA
  baseSalary     Float?
  description    String?
  requirements   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees      Employee[]

  @@index([organizationId, title])
}

model Employee {
  id                 String       @id @default(cuid())
  organizationId     String
  userId             String?      @unique
  candidateId        String?
  registrationNumber String?      // Matrícula funcional
  fullName           String
  email              String
  cpf                String?
  rg                 String?
  phone              String?
  birthDate          DateTime?
  gender             String?
  status             String       @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED, VACATION
  employmentType     String       @default("CLT") // CLT, PJ, ESTAGIO, TEMPORARIO
  admissionDate      DateTime     @default(now())
  terminationDate    DateTime?
  salary             Float?
  departmentId       String?
  positionId         String?
  managerId          String?
  workSchedule       String?      @default("08:00 - 18:00 (Seg a Sex)")
  address            String?
  bankDetails        String?      // JSON string com banco, agência, conta, PIX
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager            Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       Employee[]   @relation("EmployeeManager")

  @@index([organizationId, status])
  @@index([email])
}


